UNC_USERNAME=your_username
UNC_PASSWORD=your_password

# OES Credentials
UNC_OES_EMAIL=your_oes_email@example.com
UNC_OES_PASSWORD=your_oes_password

# NTFY (native)
NTFY_URL=https://ntfy.example.com
NTFY_TOPIC=myunc-updates
# Priority level (1-5, default: 5)
NOTIFY_PRIORITY=5

# Apprise
# Comma-separated URLs
# Examples:
#   ntfy://ntfy.sh/topic
#   telegram://bot_token/chat_id
#   discord://webhook_id/webhook_token
#   slack://hooks.slack.com/services/xxx/yyy/zzz
APPRISE_URLS=

